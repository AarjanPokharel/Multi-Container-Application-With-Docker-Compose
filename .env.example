# Copy this file to .env and fill in your own values: cp .env.example .env
# .env is git-ignored, so real credentials never get committed.
POSTGRES_DB=quotes_db
POSTGRES_USER=quotes_user
POSTGRES_PASSWORD=change-me

# "db" is the Compose service name, so the app reaches Postgres over the private network.
DATABASE_URL=postgresql://quotes_user:change-me@db:5432/quotes_db
